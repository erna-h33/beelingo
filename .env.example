# Copy this file to .env.local and fill in real values as they become
# available. The app is designed to run with these unset/placeholder:
# Supabase-backed features light up once you create a project (M2), and
# AI features are a fully optional enhancement layer (see plan Decision #2)
# that stay hidden behind manual-entry forms until OPENAI_API_KEY is set
# as a Supabase Edge Function secret (never here — never client-side).

# Supabase project (Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
