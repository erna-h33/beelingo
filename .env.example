# Copy this file to .env.local and fill in real values as they become
# available. The frontend only ever needs the Supabase project vars below.
#
# DeepL (translation) is called server-side only, from a Supabase Edge
# Function — set DEEPL_API_KEY as an Edge Function secret via
# `supabase secrets set DEEPL_API_KEY=...`, never as a VITE_-prefixed
# variable here. If DeepL is unavailable or unset, vocabulary creation is
# never blocked — the teacher just enters the translation manually.
# Wikidata's Lexeme API needs no key at all.

# Supabase project (Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
